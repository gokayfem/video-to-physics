{
  "version": 1,
  "owner": "physics/",
  "model_id": "planar_compound_sphere_rigid_massless_rod_v1",
  "conventions": "CONTRACT v1: SI, Z up, pivot at origin, bob centre = L_c*(sin th, 0, -cos th), omega = dth/dt",
  "variables": {
    "g": "gravitational acceleration [m/s^2], assumed 9.80665",
    "r": "bob sphere radius [m]",
    "l": "wire length pivot -> bob attachment (top of sphere) [m]",
    "L_c": "pivot -> bob centre distance = l + r [m]",
    "m": "bob mass = 4/3*pi*r^3*rho_b [kg]",
    "rho_b": "bob density [kg/m^3]",
    "m_w": "wire mass = rho_w*pi*d_w^2/4*l [kg] (0 in recommended model)",
    "I_P": "moment of inertia about pivot axis [kg m^2]",
    "L_eq": "equivalent simple-pendulum length = I_P/(m L_c) (massless wire) [m]",
    "omega0": "small-angle angular frequency = sqrt(g/L_eq) [rad/s]",
    "T0": "small-angle period = 2*pi/omega0 [s]",
    "theta0": "turning-point amplitude [rad]",
    "k": "elliptic modulus = sin(theta0/2) [-]",
    "K": "complete elliptic integral of first kind, K(k)=int_0^{pi/2} dphi/sqrt(1-k^2 sin^2 phi). NOTE scipy.special.ellipk(m) takes m=k^2",
    "c": "linear viscous pivot damping coefficient [N m s]",
    "gamma": "c/(2 I_P) [1/s]",
    "Q": "quality factor = I_P*omega0/c [-]",
    "tau_d": "dissipative torque, tau_d*omega >= 0 [N m]",
    "rho_a": "air density [kg/m^3]",
    "mu_a": "air dynamic viscosity [Pa s]",
    "nu_a": "air kinematic viscosity mu_a/rho_a [m^2/s]",
    "Cd": "sphere drag coefficient (steady correlation) [-]",
    "d_w": "wire diameter [m]",
    "E_w": "wire Young's modulus [Pa]",
    "tau_f": "Coulomb pivot friction torque [N m]"
  },
  "formulas": [
    {"id": "inertia_compound", "expr": "I_P = m*L_c**2 + (2/5)*m*r**2 + m_w*l**2/3", "units": "kg m^2", "note": "m_w=0 in recommended model"},
    {"id": "moment_arm", "expr": "M_arm = m*L_c + m_w*l/2", "units": "kg m"},
    {"id": "L_eq", "expr": "L_eq = I_P/M_arm  ==  L_c + 0.4*r**2/L_c (m_w=0)", "units": "m"},
    {"id": "L_c_from_L_eq_and_r", "expr": "L_c = (L_eq + sqrt(L_eq**2 - 1.6*r**2))/2", "units": "m", "valid": "m_w=0, L_eq^2 > 1.6 r^2"},
    {"id": "L_c_from_L_eq_and_ratio", "expr": "L_c = L_eq/(1 + 0.4/rho_img**2), rho_img = L_c/r", "units": "m"},
    {"id": "eom", "expr": "I_P*theta_ddot = -m*g*L_c*sin(theta) - tau_d(theta, omega)", "units": "N m", "note": "with wire mass replace m*L_c by M_arm"},
    {"id": "tau_linear_viscous", "expr": "tau_d = c*omega", "P_diss": "c*omega**2"},
    {"id": "tau_quadratic_sphere", "expr": "tau_d = 0.5*rho_a*Cd*pi*r**2*L_c**3*abs(omega)*omega", "P_diss": "0.5*rho_a*Cd*pi*r**2*L_c**3*abs(omega)**3", "note": "quasi-steady; plausibility only"},
    {"id": "tau_quadratic_wire", "expr": "tau_d = 0.5*rho_a*Cd_w*d_w*(l**4/4)*abs(omega)*omega", "Cd_w": "1 + 10*Re_w**(-2/3) (cylinder, 1<Re<2e5)"},
    {"id": "tau_stokes_oscillatory", "expr": "tau_d = 6*pi*mu_a*r*(1 + r/delta_s)*L_c**2*omega, delta_s = sqrt(2*nu_a/omega0)", "note": "dissipative part of Stokes oscillating-sphere force; plausibility only"},
    {"id": "tau_coulomb", "expr": "tau_d = tau_f*sign(omega)", "amp_loss_per_cycle": "4*tau_f/(m*g*L_c) [rad]", "note": "rejected for production"},
    {"id": "energy", "expr": "E = 0.5*I_P*omega**2 + m*g*L_c*(1 - cos(theta))", "KE": "0.5*I_P*omega**2", "PE": "m*g*L_c*(1-cos(theta))", "balance": "E(t) - E(0) + int_0^t P_diss dt = 0", "units": "J"},
    {"id": "omega_conservative", "expr": "omega**2 = 2*m*g*L_c*(cos(theta) - cos(theta0))/I_P", "units": "rad^2/s^2"},
    {"id": "tension_general", "expr": "T_wire = m*(g*cos(theta) + L_c*omega**2)", "units": "N", "note": "axial force on bob along wire; valid with damping; massless wire"},
    {"id": "tension_conservative", "expr": "T_wire = m*g*(cos(theta) + 2*(m*L_c**2/I_P)*(cos(theta) - cos(theta0)))", "min": "m*g*cos(theta0) at theta=+-theta0", "max": "m*g*(1 + 2*(m*L_c**2/I_P)*(1-cos(theta0))) at theta=0"},
    {"id": "tension_point_mass", "expr": "T = m*g*(3*cos(theta) - 2*cos(theta0))"},
    {"id": "shear_rigid", "expr": "F_perp = m*g*sin(theta)*(0.4*m*r**2/I_P)", "note": "undamped; rigid model only; ~6e-5 of tension"},
    {"id": "period_exact", "expr": "T = 4*sqrt(I_P/(m*g*L_c))*K(sin(theta0/2)) = (2/pi)*K(k)*T0", "valid": "undamped, rigid, fixed frictionless axis, 0 < theta0 < pi"},
    {"id": "period_series", "expr": "T/T0 = 1 + theta0**2/16 + 11*theta0**4/3072 + O(theta0**6)"},
    {"id": "period_small_angle", "expr": "T0 = 2*pi*sqrt(L_eq/g)", "valid": "theta0 -> 0"},
    {"id": "L_eq_from_period", "expr": "L_eq = g*(T0/(2*pi))**2, T0 = T_meas/((2/pi)*K(sin(theta0/2)))", "provenance": "model-conditioned"},
    {"id": "damped_small_angle", "expr": "theta(t) = theta0*exp(-gamma*t)*cos(omega_d*t + phi), omega_d = sqrt(omega0**2 - gamma**2), gamma = c/(2*I_P)", "valid": "linear viscous, small angle; finite-amplitude envelope exp(-gamma t) to first order in gamma"},
    {"id": "envelope_linear", "expr": "theta_amp(t) = theta0*exp(-c*t/(2*I_P))"},
    {"id": "energy_envelope_linear", "expr": "E(t) ~ E0*exp(-c*t/I_P)", "valid": "cycle-averaged, small damping"},
    {"id": "Q_and_decrement", "expr": "Q = I_P*omega0/c; log decrement delta = gamma*T_d ~ pi/Q; amp ratio after N cycles = exp(-pi*N/Q)"},
    {"id": "c_from_Q", "expr": "c = I_P*omega0/Q"},
    {"id": "quadratic_decay_per_cycle", "expr": "dA/A = (4/3)*rho_a*Cd*pi*r**2*L_c**3*A/I_P  (point mass: rho_a*Cd*L_c*A/(rho_b*r))", "note": "SHM approximation, A in rad"},
    {"id": "reynolds", "expr": "Re = L_c*abs(omega)*2*r/nu_a"},
    {"id": "wire_stretch", "expr": "delta_l = T_wire*l/(E_w*pi*d_w**2/4)", "axial_mode_freq": "sqrt(E_w*A_w/(l*m))/(2*pi)"},
    {"id": "buoyancy_added_mass_period_shift", "expr": "dT/T ~ 0.5*(rho_a/rho_b + 0.5*rho_a*V*L_c**2/I_P)", "note": "~1.1e-4; absorbed into fitted L_eq"}
  ],
  "reference_numbers_case": {
    "inputs": {"T_meas_s": 1.25, "theta0_deg": 6.0, "r_m": 0.015, "d_w_m": 3e-4, "rho_b": 8500, "g": 9.80665, "rho_a": 1.2041, "mu_a": 1.8134e-5},
    "T_over_T0": 1.00068582, "T0_s": 1.24914331, "L_eq_m": 0.38760152, "L_c_m": 0.38736919, "l_m": 0.37236919,
    "m_kg": 0.120166, "I_P_kgm2": 0.0180423, "omega_max_rad_s": 0.52650, "v_max_m_s": 0.20395,
    "Re_max": 406, "Cd_at_Re_max": 0.60, "tension_min_N": 1.17197, "tension_max_N": 1.19133,
    "stretch_static_m": 3.1e-5, "stretch_dynamic_m": 5.1e-7, "dA_over_A_per_cycle_air": 5.2e-4, "Q_air": 6000,
    "source": "physics/sanity_calc_output.json"
  },
  "physics_json_schema_proposal": {
    "each_value": {"value": "number|null", "unit": "string", "provenance": "measured|fitted|assumed|model-conditioned", "sigma_or_range": "number|[lo,hi]", "source_or_derivation": "string"},
    "required": ["model_id", "g", "T_meas", "theta_amp", "L_eq", "ratio_Lc_over_r", "L_c", "bob_radius", "wire_length", "rho_bob", "bob_mass", "I_P", "wire", "damping", "theta_init", "omega_init"],
    "defaults": {
      "g": {"value": 9.80665, "provenance": "assumed"},
      "rho_bob": {"value": 8500, "range": [8400, 8730], "provenance": "assumed"},
      "wire.diameter": {"value": 3e-4, "range": [2e-4, 5e-4], "provenance": "assumed"},
      "wire.E": {"value": 2.0e11, "range": [1.9e11, 2.1e11], "provenance": "assumed"},
      "wire.mass_included": false,
      "damping.law": "linear_viscous_pivot",
      "damping.Q": {"value": 1000, "range": [300, 6000], "provenance": "assumed unless decay measured (then fitted)"}
    }
  }
}
